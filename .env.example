# CampusNOVA — Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores de TU proyecto Supabase.
# En Vercel: configúralas en Project Settings > Environment Variables.

# URL de tu proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública anon (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Cloudinary — gestión de imágenes (upload preset debe ser "unsigned")
VITE_CLOUDINARY_CLOUD_NAME=drqfuh66o
VITE_CLOUDINARY_UPLOAD_PRESET=campusnova
